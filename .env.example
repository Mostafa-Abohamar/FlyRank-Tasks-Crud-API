# Copy to .env and fill in real values. .env is gitignored; this file is not.
#
# Local development without Docker (a Postgres running on the host):
#   DATABASE_URL=postgresql://app:app@localhost:5432/tasks
#
# Under `docker compose up` the host must be the compose service name `db`.
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tasks

DATABASE_URL=postgresql://app:change-me@db:5432/tasks
